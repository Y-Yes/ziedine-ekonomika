## Loc
##
## Very small localisation helper. The game is written in Lithuanian; when the
## language is switched to English, Loc.t() looks the Lithuanian text up in
## the EN table below (unknown texts are shown unchanged).
class_name Loc
extends RefCounted

static var lang: String = "lt"

static func load_lang() -> void:
	lang = str(Settings.get_value("lang", "lt"))

static func set_lang(l: String) -> void:
	lang = l
	Settings.set_value("lang", l)

static func t(s: String) -> String:
	if lang == "lt":
		return s
	return str(EN.get(s, s))

