## Station
##
## One processing stage on the ring. Tokens that arrive are queued in `buffer`
## and consumed at `process_rate` (tokens per second). When a token finishes
## processing the `processed` signal is emitted so the game controller can push
## the token to the next stage (or complete the loop). If a token arrives while
## the buffer is full the game treats it as an overflow (pollution).
##
## Clicking a station does "manual work": one item is processed immediately.
## Three upgrades can be bought with money: speed, capacity and added value.
class_name Station
extends Node2D

signal processed(station, token)

const BASE_RATE := 0.55   # tokens / second at level 1
const SPEED_STEP := 0.5   # +50 % of base rate per speed level
const BASE_CAP := 3       # buffer slots at level 1
const CAP_STEP := 2       # extra slots per capacity level
const VALUE_STEP := 0.5   # extra € added value per value level
const MAX_LEVEL := 10

# Upgrade prices (€) at level 1 and their growth per level (tycoon-style).
const COST_BASE := {"speed": 14.0, "cap": 10.0, "value": 25.0}
const COST_GROWTH := {"speed": 1.95, "cap": 1.8, "value": 2.1}

var index: int = 0
var speed_level: int = 1
var cap_level: int = 1
var value_level: int = 1
var speed_mult: float = 1.0      # temporary multiplier from market events
var perk_speed: float = 1.0      # permanent multiplier from investment cards
var cap_bonus: int = 0           # permanent extra slots from investment cards
var cost_mult: float = 1.0       # upgrade price multiplier (tax relief card)
var fire: float = 0.0            # seconds left burning (disaster) – station stops
var strike: float = 0.0          # seconds left on strike – station stops
var strike_cost: int = 15        # wage rise that ends the strike at once
var hazard_mult: float = 1.0     # temporary slowdown (heat wave)
var overflow_heat: float = 0.0   # recent overflows (decays) – used for buy advice
var sort_alert: float = 0.0      # >0: mixed waste waiting here (seconds left)
static var sim_speed: float = 1.0   # global slow-motion factor (sorting mini-game)
var process_rate: float = BASE_RATE
var capacity: int = BASE_CAP
var base_radius: float = 40.0

var buffer: Array[Token] = []
var selected: bool = false
var flash: float = 0.0
var punch: float = 0.0           # click feedback 1 -> 0
var upgrade_glow: float = 0.0    # purchase feedback 1 -> 0

var _timer: float = 0.0

# --- Animated art ------------------------------------------------------------
# Each station has a horizontal sprite sheet in res://art/ (ANIM_FRAMES square
# frames side by side). Generated by tools/gen_art.py.
const ART := [
	"res://art/1_naudotojas.png",
	"res://art/2_surinkimas.png",
	"res://art/3_rusiavimas.png",
	"res://art/4_perdirbimas.png",
	"res://art/5_gamykla.png",
	"res://art/6_parduotuve.png",
]
const ANIM_FRAMES := 24
const IDLE_FPS := 7.0      # animation speed while the station is empty
const BUSY_FPS := 16.0     # animation speed while processing (level 1)

var _sheet: Texture2D
var _anim: float = 0.0

func _ready() -> void:
	z_index = 1
	if index >= 0 and index < ART.size() and ResourceLoader.exists(ART[index]):
		_sheet = load(ART[index])
	# Desync stations so they don't animate in lockstep.
	_anim = float(index) * 4.0
	recompute()
	set_process(true)

# --- Stats & upgrades ----------------------------------------------------------

## Recalculate derived stats from the current upgrade levels.
func recompute() -> void:
	process_rate = rate_at(speed_level) * speed_mult * perk_speed * hazard_mult
	capacity = cap_at(cap_level) + cap_bonus
	queue_redraw()

func rate_at(level: int) -> float:
	return BASE_RATE * (1.0 + SPEED_STEP * float(level - 1))

## Economies of scale: a well-stocked storage lets the station work in
## batches – +6 % speed per storage level while it is at least half full.
const SCALE_BONUS := 0.06

func scale_active() -> bool:
	return cap_level > 1 and buffer.size() * 2 >= capacity

func effective_rate() -> float:
	if scale_active():
		return process_rate * (1.0 + SCALE_BONUS * float(cap_level - 1))
	return process_rate

func cap_at(level: int) -> int:
	return BASE_CAP + (level - 1) * CAP_STEP

func value_at(level: int) -> float:
	return Pipeline.base_value(index) + VALUE_STEP * float(level - 1)

## € this station adds to every item it processes.
func value_add() -> float:
	return value_at(value_level)

func level_of(kind: String) -> int:
	match kind:
		"speed":
			return speed_level
		"cap":
			return cap_level
		_:
			return value_level

func cost_of(kind: String) -> int:
	var lvl := level_of(kind)
	return int(round(float(COST_BASE[kind]) * pow(float(COST_GROWTH[kind]), float(lvl - 1)) * cost_mult))

## Longer explanation shown as a tooltip in the shop.
static func explain(kind: String) -> String:
	match kind:
		"speed":
			return "Greitis: stotis apdoroja daugiau daiktų per sekundę."
		"cap":
			return ("Sandėlis: telpa daugiau daiktų (matai langelius virš stoties),\n"
				+ "todėl stotis rečiau persipildo ir mažiau teršia.\n"
				+ "Masto ekonomija: kai sandėlis bent pusiau pilnas (žalia linija),\n"
				+ "stotis dirba partijomis – +6 % greičiau už kiekvieną lygį.")
		_:
			return "Pridėtinė vertė: kiekvienas šios stoties apdorotas daiktas\nparduodamas brangiau."

func is_maxed(kind: String) -> bool:
	return level_of(kind) >= MAX_LEVEL

## Human readable "now -> after purchase" text for the upgrade panel.
func preview(kind: String) -> String:
	var l := level_of(kind)
	match kind:
		"speed":
			var m := speed_mult * perk_speed
			return "Greitis %s → %s vnt./s" % [num(rate_at(l) * m), num(rate_at(l + 1) * m)]
		"cap":
			return "Telpa %d → %d daiktai. Kai pusiau pilna – dirba +%d %% greičiau" % [cap_at(l) + cap_bonus, cap_at(l + 1) + cap_bonus, int(round(SCALE_BONUS * 100.0 * float(l)))]
		_:
			if index == 0:
				return "Už grąžintą daiktą: €%s → €%s" % [_eur(value_at(l)), _eur(value_at(l + 1))]
			return "Pridėtinė vertė: +€%s → +€%s" % [_eur(value_at(l)), _eur(value_at(l + 1))]

static func _eur(v: float) -> String:
	return str(int(v)) if absf(v - round(v)) < 0.01 else ("%.1f" % v).replace(".", ",")

## Number with a Lithuanian decimal comma (2 decimals).
static func num(v: float) -> String:
	return ("%.2f" % v).replace(".", ",")

func upgrade(kind: String) -> void:
	match kind:
		"speed":
			speed_level += 1
		"cap":
			cap_level += 1
		_:
			value_level += 1
	upgrade_glow = 1.0
	recompute()

func reset_levels() -> void:
	speed_level = 1
	cap_level = 1
	value_level = 1
	speed_mult = 1.0
	perk_speed = 1.0
	cap_bonus = 0
	cost_mult = 1.0
	fire = 0.0
	strike = 0.0
	overflow_heat = 0.0
	hazard_mult = 1.0
	sort_alert = 0.0
	recompute()

# --- Buffer ---------------------------------------------------------------------

## Try to absorb an arriving token. Returns false when the buffer is full.
func receive(token: Token) -> bool:
	if buffer.size() >= capacity:
		return false
	buffer.append(token)
	token.active = false
	token.visible = false
	queue_redraw()
	return true

func clear_buffer() -> void:
	for t in buffer:
		if is_instance_valid(t):
			t.queue_free()
	buffer.clear()
	_timer = 0.0
	queue_redraw()

const CLICK_WORK := 0.35   # one click = 35 % of an item's processing

## Player clicked the station: manual work pushes the current item forward
## (several clicks finish it). If the station is on fire, clicks put it out.
func manual_process() -> bool:
	punch = 1.0
	if strike > 0.0:
		return false
	if fire > 0.0:
		fire = maxf(0.0, fire - 1.0)
		return true
	if buffer.is_empty():
		return false
	var interval := 1.0 / maxf(effective_rate(), 0.001)
	_timer += interval * CLICK_WORK
	if _timer >= interval:
		_timer -= interval
		_release_one()
	return true

func _process(real_delta: float) -> void:
	var delta := real_delta * sim_speed
	if _sheet != null:
		var fps := IDLE_FPS
		if not buffer.is_empty():
			fps = minf(BUSY_FPS * sqrt(process_rate / BASE_RATE), 36.0)
		_anim = fmod(_anim + delta * fps, float(ANIM_FRAMES))
	queue_redraw()

	if flash > 0.0:
		flash = maxf(0.0, flash - delta * 2.0)
	if punch > 0.0:
		punch = maxf(0.0, punch - delta * 5.0)
	if overflow_heat > 0.0:
		overflow_heat = maxf(0.0, overflow_heat - delta * 0.05)
	if upgrade_glow > 0.0:
		upgrade_glow = maxf(0.0, upgrade_glow - delta * 1.5)

	if fire > 0.0:
		fire = maxf(0.0, fire - delta)
		return
	if strike > 0.0:
		strike = maxf(0.0, strike - delta)
		return

	if buffer.is_empty():
		_timer = 0.0
		return

	var interval := 1.0 / maxf(effective_rate(), 0.001)
	_timer += delta
	while _timer >= interval and not buffer.is_empty():
		_timer -= interval
		_release_one()

func _release_one() -> void:
	var token: Token = buffer.pop_front()
	queue_redraw()
	processed.emit(self, token)

# --- Drawing ----------------------------------------------------------------------

func _draw() -> void:
	var accent := Pipeline.color_of(index)
	var k := 1.0 - 0.1 * sin(punch * PI)   # squish on click
	var r := base_radius * k

	# Purchase glow
	if upgrade_glow > 0.0:
		draw_circle(Vector2.ZERO, base_radius + 14.0 * upgrade_glow + 4.0, Color(accent, 0.35 * upgrade_glow))

	# Body
	draw_circle(Vector2.ZERO, r, Color(0.11, 0.13, 0.18, 1.0))

	# Animated illustration
	if _sheet != null:
		var fw := float(_sheet.get_width()) / float(ANIM_FRAMES)
		var frame := int(_anim) % ANIM_FRAMES
		var sz := r * 1.6
		draw_texture_rect_region(_sheet,
			Rect2(Vector2(-sz * 0.5, -sz * 0.5 - 2.0), Vector2(sz, sz)),
			Rect2(fw * frame, 0.0, fw, float(_sheet.get_height())))

	# Rim: dim when idle; while processing a bright arc shows progress
	# towards releasing the next token.
	var busy := not buffer.is_empty()
	draw_arc(Vector2.ZERO, r, 0.0, TAU, 48,
		accent if not busy else accent.darkened(0.35), 4.0, true)
	if busy:
		var frac := clampf(_timer * effective_rate(), 0.0, 1.0)
		if frac > 0.01:
			draw_arc(Vector2.ZERO, r, -PI * 0.5, -PI * 0.5 + TAU * frac, 48,
				accent.lightened(0.25), 5.0, true)
	if punch > 0.0:
		draw_arc(Vector2.ZERO, r + 2.0, 0.0, TAU, 48, Color(1, 1, 1, punch * 0.8), 3.0, true)

	# Fire (disaster): flickering flames over the station
	if fire > 0.0:
		var tt := Time.get_ticks_msec() / 1000.0
		draw_circle(Vector2.ZERO, r, Color(0.3, 0.05, 0.0, 0.45))
		for j in 7:
			var fx := (float(j) - 3.0) * 10.0
			var fh := 26.0 + 10.0 * sin(tt * 11.0 + float(j) * 1.7) - absf(fx) * 0.5
			var fw := 8.0
			var by := 18.0 - absf(fx) * 0.25
			draw_colored_polygon(PackedVector2Array([
				Vector2(fx - fw, by), Vector2(fx, by - fh), Vector2(fx + fw, by)]), Color(1.0, 0.35, 0.1, 0.9))
			draw_colored_polygon(PackedVector2Array([
				Vector2(fx - fw * 0.5, by), Vector2(fx, by - fh * 0.6), Vector2(fx + fw * 0.5, by)]), Color(1.0, 0.85, 0.25, 0.95))
		var font0 := ThemeDB.fallback_font
		var ft := "GESINK! %d" % int(ceil(fire))
		var fwid := font0.get_string_size(ft, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13).x
		draw_string_outline(font0, Vector2(-fwid * 0.5, -base_radius - 34.0), ft, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13, 4, Color(0, 0, 0, 0.8))
		draw_string(font0, Vector2(-fwid * 0.5, -base_radius - 34.0), ft, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13, Color(1.0, 0.6, 0.3))

	# Strike: grey overlay + sign
	if strike > 0.0:
		draw_circle(Vector2.ZERO, r, Color(0.15, 0.15, 0.18, 0.75))
		var fs := ThemeDB.fallback_font
		var t1 := "STREIKAS"
		var w1 := fs.get_string_size(t1, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12).x
		draw_rect(Rect2(-w1 * 0.5 - 6.0, -9.0, w1 + 12.0, 18.0), Color(0.85, 0.2, 0.2))
		draw_string(fs, Vector2(-w1 * 0.5, 5.0), t1, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12, Color.WHITE)
		var t2 := "Spausk: -€%d (%d s)" % [strike_cost, int(ceil(strike))]
		var w2 := fs.get_string_size(t2, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12).x
		draw_string_outline(fs, Vector2(-w2 * 0.5, -base_radius - 34.0), t2, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12, 4, Color(0, 0, 0, 0.85))
		draw_string(fs, Vector2(-w2 * 0.5, -base_radius - 34.0), t2, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12, Color(1.0, 0.7, 0.6))
	# Heat wave tint
	if hazard_mult < 1.0:
		draw_arc(Vector2.ZERO, r - 3.0, 0.0, TAU, 48, Color(1.0, 0.55, 0.15, 0.6), 3.0, true)

	# Economies of scale active – green chip
	if scale_active() and fire <= 0.0 and strike <= 0.0:
		var fc := ThemeDB.fallback_font
		var bonus := "+%d %%" % int(round(SCALE_BONUS * 100.0 * float(cap_level - 1)))
		var bw := fc.get_string_size(bonus, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 11).x + 10.0
		var row_w0 := float(mini(10, capacity)) * 9.0
		var cp := Vector2(row_w0 * 0.5 + 34.0 + bw * 0.5, -base_radius - 13.0)
		draw_rect(Rect2(cp - Vector2(bw * 0.5, 8.0), Vector2(bw, 16.0)), Color(0.2, 0.6, 0.32, 0.95))
		draw_string(fc, cp + Vector2(-bw * 0.5 + 5.0, 4.0), bonus, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 11, Color.WHITE)

	# Full storage warning – pulsing red ring
	if buffer.size() >= capacity:
		var pf := 0.5 + 0.5 * sin(Time.get_ticks_msec() / 120.0)
		draw_arc(Vector2.ZERO, base_radius + 4.0, 0.0, TAU, 48, Color(1.0, 0.3, 0.25, 0.35 + 0.4 * pf), 3.0, true)

	# Mixed waste waiting (sorting mini-game)
	if sort_alert > 0.0:
		var tt2 := Time.get_ticks_msec() / 1000.0
		var bob := sin(tt2 * 7.0) * 3.0
		var bp := Vector2(base_radius * 0.75, -base_radius * 0.75 + bob)
		draw_circle(bp, 15.0 + 2.0 * sin(tt2 * 10.0), Color(1.0, 0.85, 0.2))
		draw_circle(bp, 12.0, Color(0.95, 0.55, 0.1))
		var fnt := ThemeDB.fallback_font
		draw_string(fnt, bp + Vector2(-4.0, 7.0), "!", HORIZONTAL_ALIGNMENT_LEFT, -1, 20, Color.WHITE)
		draw_arc(Vector2.ZERO, base_radius + 9.0, -PI * 0.5, -PI * 0.5 + TAU * clampf(sort_alert / 12.0, 0.0, 1.0), 48,
			Color(1.0, 0.85, 0.2, 0.9), 3.0, true)

	# Selection highlight
	if selected:
		draw_arc(Vector2.ZERO, base_radius + 7.0, 0.0, TAU, 48, Color(1, 1, 1, 0.85), 3.0, true)

	# Overflow flash
	if flash > 0.0:
		draw_arc(Vector2.ZERO, base_radius + 3.0, 0.0, TAU, 48, Color(1.0, 0.25, 0.25, flash), 7.0, true)
		# Pollution smog puffs rising from the overflowing station.
		var g := 1.0 - flash
		for j in 4:
			var p := Vector2((float(j) - 1.5) * 13.0 + sin(g * 6.0 + j) * 4.0,
				-base_radius * 0.3 - g * 55.0 - float(j % 2) * 10.0)
			var pr := 9.0 + g * 14.0 + float(j % 2) * 3.0
			draw_circle(p, pr, Color(0.36, 0.33, 0.3, flash * 0.75))
			draw_circle(p + Vector2(-pr * 0.3, -pr * 0.3), pr * 0.45, Color(0.5, 0.47, 0.42, flash * 0.5))

	# Storage slots above the station: every place is visible (empty or full),
	# so a storage upgrade is immediately visible as extra slots.
	var n := buffer.size()
	var per_row := 10
	var bw2 := 7.0
	var gap := 2.0
	var rows := int(ceil(float(capacity) / float(per_row)))
	var half_full := n * 2 >= capacity
	for i in capacity:
		var row := i / per_row
		var col := i % per_row
		var in_row := mini(per_row, capacity - row * per_row)
		var x := (float(col) - float(in_row - 1) * 0.5) * (bw2 + gap) - bw2 * 0.5
		var y := -base_radius - 18.0 - float(row) * (bw2 + 3.0)
		var rr := Rect2(x, y, bw2, bw2 + 1.0)
		if i < n:
			draw_rect(rr, Pipeline.color_of(buffer[i].form))
		else:
			draw_rect(rr, Color(0.08, 0.1, 0.14, 0.9))
			draw_rect(rr, Color(0.45, 0.52, 0.62, 0.8), false, 1.0)
	# half-full marker (economies of scale threshold)
	if cap_level > 1:
		var hx := (float(mini(per_row, capacity)) * 0.5) * (bw2 + gap)
		var hy := -base_radius - 18.0 - float(rows - 1) * (bw2 + 3.0) - 4.0
		draw_line(Vector2(-hx - 2.0, hy), Vector2(hx, hy), Color(0.45, 0.9, 0.55, 0.9 if half_full else 0.35), 2.0)

	var font := ThemeDB.fallback_font

	# Count next to the slots (red when full)
	var slot_text := "%d/%d" % [n, capacity]
	var slot_col := Color(0.85, 0.9, 0.96, 0.9)
	if n >= capacity:
		slot_col = Color(1.0, 0.4, 0.35)
	elif n >= capacity - 1:
		slot_col = Color(1.0, 0.8, 0.35)
	var row_w := float(mini(per_row, capacity)) * (bw2 + gap)
	draw_string(font, Vector2(row_w * 0.5 + 4.0, -base_radius - 9.0), slot_text,
		HORIZONTAL_ALIGNMENT_LEFT, -1.0, 12, slot_col)

	# Name below the station
	draw_string(font, Vector2(-base_radius, base_radius + 20.0), Pipeline.name_of(index),
		HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13, accent.lightened(0.15))
